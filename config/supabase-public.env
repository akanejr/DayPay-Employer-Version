# DayPay Employer Version — PUBLIC Supabase configuration.
#
# SAFE TO COMMIT. Both values below are designed to be public: they ship to the
# browser inside the app bundle on every deploy. The publishable key carries
# role "anon" and grants nothing on its own — every read and write is filtered
# by Row Level Security.
#
# DO NOT ADD ANY OF THESE HERE, EVER:
#   - secret / service_role key   (sb_secret_… , bypasses ALL RLS)
#   - database password
#   - personal access token       (sbp_… , manages the whole account)
#
# If one of those needs to exist, it goes in .env (gitignored), never here.

VITE_SUPABASE_URL=https://crirzuoehbkzpnwokyxl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable__dh7r1RnxEEEPuP08z1zEw_iPk6NywS
